[Unit]
Description=BOBR status bot — контроль договорённостей во внедренческом чате
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bots
WorkingDirectory=/opt/bobr-status-bot
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
# Токены читаются из .env в WorkingDirectory. Права: chmod 600 .env
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
