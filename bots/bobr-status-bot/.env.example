# --- Telegram ---
# Токен от @BotFather. В чат не пересылать, хранить только здесь.
TELEGRAM_BOT_TOKEN=123456:AA...

# ID группы «645 ID | BOBR», за которой следит бот (отрицательное число).
# Узнать: добавить бота в группу и отправить там /chatid
BOBR_CHAT_ID=-1001234567890

# Куда бот шлёт уведомления о смене статуса. По умолчанию — отдельный
# внутренний чат нашей команды, чтобы не спамить в группу вендора.
TEAM_CHAT_ID=-1009876543210

# Кому разрешены команды бота (Telegram user id через запятую).
# Узнать свой id: @userinfobot
ADMIN_USER_IDS=123456789,987654321

# --- Claude API ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max — глубина рассуждений при разборе чата
ANTHROPIC_EFFORT=medium

# --- Поведение ---
# Как часто разбирать накопленные сообщения, секунд
ANALYZE_INTERVAL_SEC=120
# Минимум новых сообщений для внеочередного разбора
ANALYZE_MIN_BATCH=5
# Дублировать уведомления в саму группу BOBR (true/false)
NOTIFY_IN_SOURCE_CHAT=false
# Ежедневная сводка, локальное время
DIGEST_HOUR=10
DIGEST_MINUTE=0
# Файл состояния
DATA_FILE=./data/state.json
# Часовой пояс для дат и сроков
TZ=Europe/Moscow
