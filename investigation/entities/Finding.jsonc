// Сгенерировано investigation/tools/generate-entities.mjs.
// Не редактировать вручную: изменения вносятся в entity-definitions.mjs.
// Сущность: Finding
{
  "name": "Finding",
  "type": "object",
  "description": "Итоговый вывод",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organization"
    },
    "case_id": {
      "type": "string",
      "title": "Case"
    },
    "finding_code": {
      "type": "string",
      "title": "Finding Code"
    },
    "statement": {
      "type": "string",
      "title": "Statement"
    },
    "finding_type": {
      "type": "string",
      "enum": [
        "fact",
        "corroborated_claim",
        "inference",
        "unresolved",
        "procedural_failure",
        "root_cause"
      ],
      "title": "Finding Type"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "very_low",
        "low",
        "moderate",
        "high",
        "very_high"
      ],
      "title": "Confidence"
    },
    "supporting_claim_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Supporting Claim ids"
    },
    "supporting_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Supporting Evidence ids"
    },
    "contradicting_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Contradicting Evidence ids"
    },
    "alternative_explanations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Alternative Explanations"
    },
    "issue_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Issue ids"
    },
    "hypothesis_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Hypothesis ids"
    },
    "review_status": {
      "type": "string",
      "enum": [
        "draft",
        "under_review",
        "approved",
        "rejected"
      ],
      "title": "Review Status"
    },
    "approval_id": {
      "type": "string",
      "title": "Approval"
    },
    "approved_by": {
      "type": "string",
      "title": "Approved By"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time",
      "title": "Approved At"
    },
    "created_by_agent": {
      "type": "string",
      "title": "Created By Agent"
    },
    "agent_run_id": {
      "type": "string",
      "title": "Agent Run"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time",
      "title": "Deleted At"
    },
    "deleted_by": {
      "type": "string",
      "title": "Deleted By"
    },
    "deletion_reason": {
      "type": "string",
      "title": "Deletion Reason"
    }
  },
  "required": [
    "organization_id",
    "finding_code",
    "statement",
    "finding_type",
    "case_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "system_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "org_owner"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "investigation_manager"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "investigator"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "system_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "org_owner"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "investigation_manager"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "investigator"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "reviewer"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "read_only"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "system_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "org_owner"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "investigation_manager"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "investigator"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "reviewer"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "system_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "org_owner"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "investigation_manager"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        }
      ]
    }
  }
}
