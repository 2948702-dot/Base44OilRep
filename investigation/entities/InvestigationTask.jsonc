// Сгенерировано investigation/tools/generate-entities.mjs.
// Не редактировать вручную: изменения вносятся в entity-definitions.mjs.
// Сущность: InvestigationTask
{
  "name": "InvestigationTask",
  "type": "object",
  "description": "Задача расследования",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organization"
    },
    "case_id": {
      "type": "string",
      "title": "Case"
    },
    "title": {
      "type": "string",
      "title": "Title"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "task_type": {
      "type": "string",
      "enum": [
        "request_document",
        "request_cctv",
        "request_bank_statement",
        "request_system_log",
        "interview",
        "follow_up_interview",
        "site_visit",
        "expert_review",
        "other"
      ],
      "title": "Task Type"
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "accepted",
        "in_progress",
        "completed",
        "cancelled",
        "blocked"
      ],
      "title": "Status"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Priority"
    },
    "assignee_id": {
      "type": "string",
      "title": "Assignee"
    },
    "due_at": {
      "type": "string",
      "format": "date-time",
      "title": "Due At"
    },
    "issue_id": {
      "type": "string",
      "title": "Issue"
    },
    "hypothesis_id": {
      "type": "string",
      "title": "Hypothesis"
    },
    "contradiction_id": {
      "type": "string",
      "title": "Contradiction"
    },
    "person_id": {
      "type": "string",
      "title": "Person"
    },
    "evidence_id": {
      "type": "string",
      "title": "Evidence"
    },
    "expected_information_gain": {
      "type": "string",
      "enum": [
        "very_low",
        "low",
        "moderate",
        "high",
        "very_high"
      ],
      "title": "Expected Information Gain"
    },
    "urgency": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Urgency"
    },
    "estimated_cost": {
      "type": "string",
      "title": "Estimated Cost"
    },
    "reason": {
      "type": "string",
      "title": "Reason"
    },
    "created_by_agent": {
      "type": "string",
      "title": "Created By Agent"
    },
    "agent_run_id": {
      "type": "string",
      "title": "Agent Run"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time",
      "title": "Deleted At"
    },
    "deleted_by": {
      "type": "string",
      "title": "Deleted By"
    },
    "deletion_reason": {
      "type": "string",
      "title": "Deletion Reason"
    }
  },
  "required": [
    "organization_id",
    "title",
    "status",
    "case_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "system_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "org_owner"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "investigation_manager"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "investigator"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "system_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "org_owner"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "investigation_manager"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "investigator"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "reviewer"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "read_only"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "system_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "org_owner"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "investigation_manager"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "investigator"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "system_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "org_owner"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "investigation_manager"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        }
      ]
    }
  }
}
