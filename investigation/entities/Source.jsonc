// Сгенерировано investigation/tools/generate-entities.mjs.
// Не редактировать вручную: изменения вносятся в entity-definitions.mjs.
// Сущность: Source
{
  "name": "Source",
  "type": "object",
  "description": "Источник информации",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organization"
    },
    "case_id": {
      "type": "string",
      "title": "Case"
    },
    "type": {
      "type": "string",
      "enum": [
        "interview_audio",
        "interview_transcript",
        "document",
        "email",
        "messenger",
        "bank_statement",
        "accounting_record",
        "crm",
        "gps",
        "cctv",
        "photo",
        "video",
        "witness_statement",
        "system_log",
        "external_source"
      ],
      "title": "Type"
    },
    "title": {
      "type": "string",
      "title": "Title"
    },
    "original_file": {
      "type": "string",
      "title": "Original File"
    },
    "sha256": {
      "type": "string",
      "title": "Sha256"
    },
    "original_filename": {
      "type": "string",
      "title": "Original Filename"
    },
    "mime_type": {
      "type": "string",
      "title": "Mime Type"
    },
    "byte_size": {
      "type": "number",
      "title": "Byte Size"
    },
    "created_at_original": {
      "type": "string",
      "format": "date-time",
      "title": "Created At Original"
    },
    "received_at": {
      "type": "string",
      "format": "date-time",
      "title": "Received At"
    },
    "uploaded_by": {
      "type": "string",
      "title": "Uploaded By"
    },
    "source_person_id": {
      "type": "string",
      "title": "Source Person"
    },
    "system_origin": {
      "type": "string",
      "title": "System Origin"
    },
    "integrity_status": {
      "type": "string",
      "enum": [
        "verified",
        "unverified",
        "mismatch",
        "unavailable"
      ],
      "title": "Integrity Status"
    },
    "is_derived": {
      "type": "boolean",
      "title": "Is Derived"
    },
    "derived_from_source_id": {
      "type": "string",
      "title": "Derived From Source"
    },
    "derivation_method": {
      "type": "string",
      "title": "Derivation Method"
    },
    "untrusted_content": {
      "type": "boolean",
      "title": "Untrusted Content"
    },
    "extracted_text": {
      "type": "string",
      "title": "Extracted Text"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time",
      "title": "Deleted At"
    },
    "deleted_by": {
      "type": "string",
      "title": "Deleted By"
    },
    "deletion_reason": {
      "type": "string",
      "title": "Deletion Reason"
    }
  },
  "required": [
    "organization_id",
    "type",
    "case_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "system_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "org_owner"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "investigation_manager"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "investigator"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "system_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "org_owner"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "investigation_manager"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "investigator"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "reviewer"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "read_only"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "system_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "org_owner"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "investigation_manager"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "investigator"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "system_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "org_owner"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "investigation_manager"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        }
      ]
    }
  }
}
