// Сущность: InvestigationJob
{
  "name": "InvestigationJob",
  "type": "object",
  "description": "Фоновая задача",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organization"
    },
    "case_id": {
      "type": "string",
      "title": "Case"
    },
    "job_type": {
      "type": "string",
      "enum": [
        "transcription",
        "document_parse",
        "claim_extraction",
        "timeline_rebuild",
        "contradiction_scan",
        "hypothesis_review",
        "report_generation"
      ],
      "title": "Job Type"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "completed",
        "failed"
      ],
      "title": "Status"
    },
    "payload": {
      "type": "object",
      "title": "Payload"
    },
    "result": {
      "type": "object",
      "title": "Result"
    },
    "error": {
      "type": "string",
      "title": "Error"
    },
    "attempts": {
      "type": "number",
      "title": "Attempts"
    },
    "scheduled_at": {
      "type": "string",
      "format": "date-time",
      "title": "Scheduled At"
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "title": "Started At"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time",
      "title": "Finished At"
    },
    "agent_run_id": {
      "type": "string",
      "title": "Agent Run"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time",
      "title": "Deleted At"
    },
    "deleted_by": {
      "type": "string",
      "title": "Deleted By"
    },
    "deletion_reason": {
      "type": "string",
      "title": "Deletion Reason"
    }
  },
  "required": [
    "organization_id",
    "job_type",
    "status",
    "case_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "system_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "org_owner"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "investigation_manager"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "investigator"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        }
      ]
    },
