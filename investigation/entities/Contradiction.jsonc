// Сущность: Contradiction
{
  "name": "Contradiction",
  "type": "object",
  "description": "Противоречие",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organization"
    },
    "case_id": {
      "type": "string",
      "title": "Case"
    },
    "contradiction_code": {
      "type": "string",
      "title": "Contradiction Code"
    },
    "claim_a_id": {
      "type": "string",
      "title": "Claim A"
    },
    "claim_b_id": {
      "type": "string",
      "title": "Claim B"
    },
    "type": {
      "type": "string",
      "enum": [
        "direct",
        "temporal",
        "financial",
        "location",
        "identity",
        "sequence",
        "documentary",
        "partial"
      ],
      "title": "Type"
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Severity"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "issue_id": {
      "type": "string",
      "title": "Issue"
    },
    "resolution_status": {
      "type": "string",
      "enum": [
        "open",
        "under_investigation",
        "resolved",
        "unresolvable"
      ],
      "title": "Resolution Status"
    },
    "recommended_checks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Recommended Checks"
    },
    "resolved_by": {
      "type": "string",
      "title": "Resolved By"
    },
    "resolution_note": {
      "type": "string",
      "title": "Resolution Note"
    },
    "created_by_agent": {
      "type": "string",
      "title": "Created By Agent"
    },
    "agent_run_id": {
      "type": "string",
      "title": "Agent Run"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time",
      "title": "Deleted At"
    },
    "deleted_by": {
      "type": "string",
      "title": "Deleted By"
    },
    "deletion_reason": {
      "type": "string",
      "title": "Deletion Reason"
    }
  },
  "required": [
    "organization_id",
    "contradiction_code",
    "claim_a_id",
    "claim_b_id",
    "type",
    "case_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "system_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "org_owner"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "investigation_manager"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "investigator"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        }
      ]
    },
