    },
    "relationship_to_incident": {
      "type": "string",
      "title": "Relationship To Incident"
    },
    "participant_type": {
      "type": "string",
      "enum": [
        "subject",
        "witness",
        "reporter",
        "manager",
        "victim",
        "customer",
        "external",
        "investigator",
        "unknown"
      ],
      "title": "Participant Type"
    },
    "participant_type_changed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Participant Type Changed At"
    },
