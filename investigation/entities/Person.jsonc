// Сущность: Person
{
  "name": "Person",
  "type": "object",
  "description": "Участник дела",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organization"
    },
    "case_id": {
      "type": "string",
      "title": "Case"
    },
    "name": {
      "type": "string",
      "title": "Name"
    },
