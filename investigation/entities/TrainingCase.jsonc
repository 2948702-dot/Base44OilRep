// Сгенерировано investigation/tools/generate-entities.mjs.
// Не редактировать вручную: изменения вносятся в entity-definitions.mjs.
// Сущность: TrainingCase
{
  "name": "TrainingCase",
  "type": "object",
  "description": "Учебное дело",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organization"
    },
    "title": {
      "type": "string",
      "title": "Title"
    },
    "type": {
      "type": "string",
      "enum": [
        "real_public",
        "synthetic",
        "fiction_adapted",
        "internal_anonymized"
      ],
      "title": "Type"
    },
    "scenario": {
      "type": "string",
      "title": "Scenario"
    },
    "ground_truth": {
      "type": "object",
      "title": "Ground Truth"
    },
    "initial_information": {
      "type": "string",
      "title": "Initial Information"
    },
    "evidence_sequence": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "title": "Evidence Sequence"
    },
    "persons": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "title": "Persons"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "title": "Events"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "title": "Claims"
    },
    "correct_hypotheses": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Correct Hypotheses"
    },
    "misleading_hypotheses": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Misleading Hypotheses"
    },
    "expected_investigative_actions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Expected Investigative Actions"
    },
    "published": {
      "type": "boolean",
      "title": "Published"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time",
      "title": "Deleted At"
    },
    "deleted_by": {
      "type": "string",
      "title": "Deleted By"
    },
    "deletion_reason": {
      "type": "string",
      "title": "Deletion Reason"
    }
  },
  "required": [
    "organization_id",
    "title",
    "type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "system_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "org_owner"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "system_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "org_owner"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "investigation_manager"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "investigator"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "reviewer"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "read_only"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "system_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "org_owner"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "system_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "org_owner"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        }
      ]
    }
  }
}
