// Сгенерировано investigation/tools/generate-entities.mjs.
// Не редактировать вручную: изменения вносятся в entity-definitions.mjs.
// Сущность: AgentRun
{
  "name": "AgentRun",
  "type": "object",
  "description": "Запуск агента",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organization"
    },
    "case_id": {
      "type": "string",
      "title": "Case"
    },
    "agent_type": {
      "type": "string",
      "title": "Agent Type"
    },
    "agent_version": {
      "type": "string",
      "title": "Agent Version"
    },
    "prompt_version": {
      "type": "string",
      "title": "Prompt Version"
    },
    "model": {
      "type": "string",
      "title": "Model"
    },
    "input_object_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Input Object ids"
    },
    "input_digest": {
      "type": "string",
      "title": "Input Digest"
    },
    "output": {
      "type": "object",
      "title": "Output"
    },
    "output_schema_version": {
      "type": "string",
      "title": "Output Schema Version"
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "title": "Started At"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time",
      "title": "Finished At"
    },
    "input_tokens": {
      "type": "number",
      "title": "Input Tokens"
    },
    "output_tokens": {
      "type": "number",
      "title": "Output Tokens"
    },
    "cost": {
      "type": "number",
      "title": "Cost"
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "completed",
        "failed",
        "rejected_schema",
        "cancelled"
      ],
      "title": "Status"
    },
    "error": {
      "type": "string",
      "title": "Error"
    },
    "triggered_by": {
      "type": "string",
      "title": "Triggered By"
    },
    "job_id": {
      "type": "string",
      "title": "Job"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time",
      "title": "Deleted At"
    },
    "deleted_by": {
      "type": "string",
      "title": "Deleted By"
    },
    "deletion_reason": {
      "type": "string",
      "title": "Deletion Reason"
    }
  },
  "required": [
    "organization_id",
    "agent_type",
    "status",
    "case_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "system_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "org_owner"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "investigation_manager"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "investigator"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "system_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "org_owner"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "investigation_manager"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "investigator"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "reviewer"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "read_only"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "data.organization_id": "__immutable__"
    },
    "delete": {
      "data.organization_id": "__immutable__"
    }
  }
}
