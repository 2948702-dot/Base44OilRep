// Сущность: KnowledgeDocument
{
  "name": "KnowledgeDocument",
  "type": "object",
  "description": "Документ knowledge space",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organization"
    },
    "case_id": {
      "type": "string",
      "title": "Case"
    },
    "space": {
      "type": "string",
      "enum": [
        "methodology",
        "case"
      ],
      "title": "Space"
    },
    "title": {
      "type": "string",
      "title": "Title"
    },
    "content": {
      "type": "string",
      "title": "Content"
    },
    "chunk_index": {
      "type": "number",
      "title": "Chunk Index"
    },
