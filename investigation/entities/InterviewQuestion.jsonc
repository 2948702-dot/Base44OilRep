// Сущность: InterviewQuestion
{
  "name": "InterviewQuestion",
  "type": "object",
  "description": "Вопрос интервью",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organization"
    },
    "case_id": {
      "type": "string",
      "title": "Case"
    },
    "interview_id": {
      "type": "string",
      "title": "Interview"
    },
    "question": {
      "type": "string",
      "title": "Question"
    },
    "question_type": {
      "type": "string",
      "enum": [
        "open",
        "clarification",
        "probing",
        "chronology",
        "corroboration",
        "challenge",
        "closing"
      ],
      "title": "Question Type"
    },
    "purpose": {
      "type": "string",
      "title": "Purpose"
    },
    "issue_id": {
      "type": "string",
      "title": "Issue"
    },
    "hypothesis_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Hypothesis ids"
    },
    "sequence": {
      "type": "number",
      "title": "Sequence"
    },
    "generated_by": {
      "type": "string",
      "enum": [
        "agent",
        "human"
      ],
      "title": "Generated By"
    },
    "generated_by_agent": {
      "type": "string",
      "title": "Generated By Agent"
    },
    "agent_run_id": {
      "type": "string",
      "title": "Agent Run"
    },
    "sensitive": {
      "type": "boolean",
      "title": "Sensitive"
    },
    "approval_id": {
      "type": "string",
      "title": "Approval"
    },
    "approved_by": {
      "type": "string",
      "title": "Approved By"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time",
      "title": "Approved At"
    },
    "asked_at": {
      "type": "string",
      "format": "date-time",
      "title": "Asked At"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "approved",
        "asked",
        "answered",
        "skipped"
      ],
      "title": "Status"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time",
      "title": "Deleted At"
    },
    "deleted_by": {
      "type": "string",
      "title": "Deleted By"
    },
    "deletion_reason": {
      "type": "string",
      "title": "Deletion Reason"
    }
  },
  "required": [
    "organization_id",
    "interview_id",
    "question",
    "question_type",
    "case_id"
  ],
