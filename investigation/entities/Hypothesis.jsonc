// Сгенерировано investigation/tools/generate-entities.mjs.
// Не редактировать вручную: изменения вносятся в entity-definitions.mjs.
// Сущность: Hypothesis
{
  "name": "Hypothesis",
  "type": "object",
  "description": "Версия расследования",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organization"
    },
    "case_id": {
      "type": "string",
      "title": "Case"
    },
    "code": {
      "type": "string",
      "title": "Code"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "type": {
      "type": "string",
      "enum": [
        "primary",
        "alternative",
        "exculpatory",
        "procedural",
        "accounting_error",
        "technical_error",
        "unknown"
      ],
      "title": "Type"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "weakened",
        "supported",
        "contradicted",
        "eliminated",
        "unresolved"
      ],
      "title": "Status"
    },
    "created_by_agent": {
      "type": "string",
      "title": "Created By Agent"
    },
    "agent_run_id": {
      "type": "string",
      "title": "Agent Run"
    },
    "issue_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Issue ids"
    },
    "support_score": {
      "type": "number",
      "title": "Support Score"
    },
    "contradiction_score": {
      "type": "number",
      "title": "Contradiction Score"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "very_low",
        "low",
        "moderate",
        "high",
        "very_high"
      ],
      "title": "Confidence"
    },
    "evidence_that_would_support": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Evidence That Would Support"
    },
    "evidence_that_would_contradict": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Evidence That Would Contradict"
    },
    "missing_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Missing Evidence"
    },
    "alternative_explanations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Alternative Explanations"
    },
    "red_team_notes": {
      "type": "string",
      "title": "Red Team Notes"
    },
    "defence_review_notes": {
      "type": "string",
      "title": "Defence Review Notes"
    },
    "last_reviewed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Last Reviewed At"
    },
    "closure_approval_id": {
      "type": "string",
      "title": "Closure Approval"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time",
      "title": "Deleted At"
    },
    "deleted_by": {
      "type": "string",
      "title": "Deleted By"
    },
    "deletion_reason": {
      "type": "string",
      "title": "Deletion Reason"
    }
  },
  "required": [
    "organization_id",
    "code",
    "description",
    "type",
    "status",
    "case_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "system_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "org_owner"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "investigation_manager"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "investigator"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "system_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "org_owner"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "investigation_manager"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "investigator"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "reviewer"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "read_only"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "system_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "org_owner"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "investigation_manager"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "investigator"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "system_admin"
      }
    }
  }
}
