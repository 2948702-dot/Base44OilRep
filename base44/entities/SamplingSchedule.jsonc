{
  "name": "SamplingSchedule",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "title": "Client"
    },
    "asset_id": {
      "type": "string",
      "title": "Asset"
    },
    "equipment_unit_id": {
      "type": "string",
      "title": "Equipment Unit"
    },
    "schedule_name": {
      "type": "string",
      "title": "Schedule Name"
    },
    "is_active": {
      "type": "boolean",
      "title": "Is Active"
    },
    "stages": {
      "type": "array",
      "title": "Schedule Stages",
      "items": {
        "type": "object",
        "properties": {
          "stage_number": {
            "type": "number"
          },
          "trigger_type": {
            "type": "string",
            "enum": [
              "always",
              "after_n_samples"
            ]
          },
          "trigger_value": {
            "type": "number"
          },
          "frequency_type": {
            "type": "string",
            "enum": [
              "days",
              "weeks",
              "months",
              "hours",
              "hours_or_days_first"
            ]
          },
          "frequency_value": {
            "type": "number"
          },
          "frequency_value_hours": {
            "type": "number"
          }
        }
      }
    },
    "next_sample_due_date": {
      "type": "string",
      "title": "Next Sample Due Date",
      "format": "date"
    },
    "next_sample_due_hours": {
      "type": "number",
      "title": "Next Sample Due Hours"
    },
    "current_stage": {
      "type": "number",
      "title": "Current Stage"
    },
    "samples_in_current_stage": {
      "type": "number",
      "title": "Samples in Current Stage"
    },
    "comments": {
      "type": "string",
      "title": "Comments"
    }
  },
  "required": [
    "client_id",
    "asset_id",
    "equipment_unit_id",
    "schedule_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "superintendent"
              }
            },
            {
              "data.client_id": "{{user.client_id}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "superintendent"
              }
            },
            {
              "data.client_id": "{{user.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "captain"
              }
            },
            {
              "data.asset_id": "{{user.asset_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "superintendent"
              }
            },
            {
              "data.client_id": "{{user.client_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "superintendent"
              }
            },
            {
              "data.client_id": "{{user.client_id}}"
            }
          ]
        }
      ]
    }
  }
}
