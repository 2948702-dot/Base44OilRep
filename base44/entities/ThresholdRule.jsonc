{
  "name": "ThresholdRule",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "title": "Client (Optional)"
    },
    "asset_id": {
      "type": "string",
      "title": "Asset (Optional)"
    },
    "equipment_unit_id": {
      "type": "string",
      "title": "Equipment Unit (Optional)"
    },
    "sampling_point_id": {
      "type": "string",
      "title": "Sampling Point (Optional)"
    },
    "oil_type_id": {
      "type": "string",
      "title": "Oil Type (Optional)"
    },
    "equipment_type": {
      "type": "string",
      "title": "Equipment Type",
      "enum": [
        "main_engine",
        "aux_engine",
        "generator",
        "gearbox",
        "hydraulic",
        "compressor",
        "pump",
        "other",
        "all"
      ]
    },
    "parameter_name": {
      "type": "string",
      "title": "Parameter Name"
    },
    "green_min": {
      "type": "number",
      "title": "Green Min"
    },
    "green_max": {
      "type": "number",
      "title": "Green Max"
    },
    "yellow_min": {
      "type": "number",
      "title": "Yellow Min"
    },
    "yellow_max": {
      "type": "number",
      "title": "Yellow Max"
    },
    "red_min": {
      "type": "number",
      "title": "Red Min"
    },
    "red_max": {
      "type": "number",
      "title": "Red Max"
    },
    "unit": {
      "type": "string",
      "title": "Unit"
    },
    "comments": {
      "type": "string",
      "title": "Comments"
    }
  },
  "required": [
    "equipment_type",
    "parameter_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "superintendent"
              }
            },
            {
              "$or": [
                {
                  "data.client_id": null
                },
                {
                  "data.client_id": "{{user.client_id}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "superintendent"
              }
            },
            {
              "$or": [
                {
                  "data.client_id": null
                },
                {
                  "data.client_id": "{{user.client_id}}"
                }
              ]
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "captain"
              }
            },
            {
              "$or": [
                {
                  "data.client_id": null,
                  "data.asset_id": null
                },
                {
                  "data.asset_id": "{{user.asset_id}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "superintendent"
              }
            },
            {
              "$or": [
                {
                  "data.client_id": null
                },
                {
                  "data.client_id": "{{user.client_id}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "superintendent"
              }
            },
            {
              "$or": [
                {
                  "data.client_id": null
                },
                {
                  "data.client_id": "{{user.client_id}}"
                }
              ]
            }
          ]
        }
      ]
    }
  }
}