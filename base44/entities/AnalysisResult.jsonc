{
  "name": "AnalysisResult",
  "type": "object",
  "properties": {
    "sample_id": {
      "type": "string",
      "title": "Oil Sample"
    },
    "iron_mg_l": {
      "type": "number",
      "title": "Iron (mg/L)"
    },
    "water_ppm": {
      "type": "number",
      "title": "Dissolved Water (ppm)"
    },
    "water_activity": {
      "type": "number",
      "title": "Water Activity (aw)"
    },
    "viscosity_40": {
      "type": "number",
      "title": "Viscosity at 40C (mm2/s)"
    },
    "viscosity_100": {
      "type": "number",
      "title": "Viscosity at 100C (mm2/s)"
    },
    "density": {
      "type": "number",
      "title": "Density (kg/m3)"
    },
    "dielectric_constant": {
      "type": "number",
      "title": "Dielectric Constant"
    },
    "water_index": {
      "type": "number",
      "title": "Water Index (0-100)"
    },
    "wear_index": {
      "type": "number",
      "title": "Wear Index (0-100)"
    },
    "viscosity_index_calc": {
      "type": "number",
      "title": "Viscosity Index (0-100)"
    },
    "dielectric_index": {
      "type": "number",
      "title": "Dielectric Index (0-100)"
    },
    "oil_health_index": {
      "type": "number",
      "title": "Oil Health Index (0-100)"
    },
    "overall_status": {
      "type": "string",
      "title": "Overall Status",
      "enum": [
        "green",
        "yellow",
        "red"
      ]
    },
    "recommendation_text": {
      "type": "string",
      "title": "Recommendation"
    }
  },
  "required": [
    "sample_id"
  ]
}