{
  "name": "AnalysisResult",
  "type": "object",
  "properties": {
    "sample_id": {
      "type": "string",
      "title": "Oil Sample"
    },
    "client_id": {
      "type": "string",
      "title": "Client"
    },
    "asset_id": {
      "type": "string",
      "title": "Asset"
    },
    "iron_mg_l": {
      "type": "number",
      "title": "Iron (mg/L)"
    },
    "water_ppm": {
      "type": "number",
      "title": "Dissolved Water (ppm)"
    },
    "water_activity": {
      "type": "number",
      "title": "Water Activity (%)"
    },
    "viscosity_40": {
      "type": "number",
      "title": "Viscosity at 40C (mm2/s)"
    },
    "density": {
      "type": "number",
      "title": "Density (kg/m3)"
    },
    "dielectric_constant": {
      "type": "number",
      "title": "Dielectric Constant"
    },
    "wear_index": {
      "type": "number",
      "title": "Wear Index (0-100)"
    },
    "oil_health_index": {
      "type": "number",
      "title": "Oil Health Index (0-100)"
    },
    "overall_status": {
      "type": "string",
      "title": "Overall Status",
      "enum": [
        "green",
        "yellow",
        "red"
      ]
    },
    "recommendation_text": {
      "type": "string",
      "title": "Recommendation"
    }
  },
  "required": [
    "sample_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "lab_technician"
              }
            },
            {
              "data.client_id": "{{user.client_id}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "client_admin"
              }
            },
            {
              "data.client_id": "{{user.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "lab_technician"
              }
            },
            {
              "data.client_id": "{{user.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "superintendent"
              }
            },
            {
              "data.client_id": "{{user.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "captain"
              }
            },
            {
              "data.asset_id": "{{user.asset_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "lab_technician"
              }
            },
            {
              "data.client_id": "{{user.client_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "lab_technician"
              }
            },
            {
              "data.client_id": "{{user.client_id}}"
            }
          ]
        }
      ]
    }
  }
}
