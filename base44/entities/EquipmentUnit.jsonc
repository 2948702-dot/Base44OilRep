{
  "name": "EquipmentUnit",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "title": "Client"
    },
    "asset_id": {
      "type": "string",
      "title": "Asset"
    },
    "unit_name": {
      "type": "string",
      "title": "Unit Name"
    },
    "equipment_type": {
      "type": "string",
      "title": "Equipment Type",
      "enum": [
        "main_engine",
        "aux_engine",
        "generator",
        "gearbox",
        "hydraulic",
        "compressor",
        "pump",
        "other"
      ]
    },
    "manufacturer": {
      "type": "string",
      "title": "Manufacturer"
    },
    "model": {
      "type": "string",
      "title": "Model"
    },
    "serial_number": {
      "type": "string",
      "title": "Serial Number"
    },
    "sampling_qr_code": {
      "type": "string",
      "title": "Sampling QR Code"
    },
    "sampling_method": {
      "type": "string",
      "title": "Sampling Method",
      "enum": [
        "pump",
        "drain_plug",
        "minimess_port"
      ]
    },
    "total_operating_hours": {
      "type": "number",
      "title": "\u0421\u0442\u0430\u0440\u0442\u043e\u0432\u044b\u0435 \u043c/\u0447 \u0430\u0433\u0440\u0435\u0433\u0430\u0442\u0430"
    },
    "initial_oil_hours": {
      "type": "number",
      "title": "\u0421\u0442\u0430\u0440\u0442\u043e\u0432\u044b\u0435 \u043c/\u0447 \u043c\u0430\u0441\u043b\u0430"
    },
    "current_total_hours": {
      "type": "number",
      "title": "\u0422\u0435\u043a\u0443\u0449\u0438\u0435 \u043c/\u0447 \u0430\u0433\u0440\u0435\u0433\u0430\u0442\u0430"
    },
    "current_oil_hours": {
      "type": "number",
      "title": "\u0422\u0435\u043a\u0443\u0449\u0438\u0435 \u043c/\u0447 \u043c\u0430\u0441\u043b\u0430"
    },
    "current_oil_type_id": {
      "type": "string",
      "title": "\u0422\u0435\u043a\u0443\u0449\u0435\u0435 \u043c\u0430\u0441\u043b\u043e"
    },
    "last_hours_update_date": {
      "type": "string",
      "title": "\u0414\u0430\u0442\u0430 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0433\u043e \u043e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u044f \u043c/\u0447",
      "format": "date"
    },
    "oil_type_id": {
      "type": "string",
      "title": "Oil Type (ref)"
    },
    "oil_brand": {
      "type": "string",
      "title": "Oil Brand / Name"
    },
    "oil_volume": {
      "type": "number",
      "title": "Oil Volume (L)"
    },
    "oil_change_type": {
      "type": "string",
      "title": "Oil Change Method",
      "enum": [
        "engine_hours",
        "mileage",
        "calendar",
        "condition"
      ]
    },
    "oil_change_interval": {
      "type": "number",
      "title": "Oil Change Interval"
    },
    "oil_change_interval_unit": {
      "type": "string",
      "title": "Oil Change Interval Unit",
      "enum": [
        "days",
        "weeks",
        "months"
      ]
    },
    "oil_filter_type": {
      "type": "string",
      "title": "Oil Filter Type"
    },
    "oil_filter_brand": {
      "type": "string",
      "title": "Oil Filter Brand"
    },
    "oil_filter_article": {
      "type": "string",
      "title": "Oil Filter Article"
    },
    "use_standard_thresholds": {
      "type": "boolean",
      "title": "\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u044b\u0435 \u0433\u0440\u0430\u043d\u0438\u0446\u044b \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u043e\u0432 \u043c\u0430\u0441\u043b\u0430"
    },
    "custom_thresholds": {
      "type": "array",
      "title": "\u0418\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u044b\u0435 \u0433\u0440\u0430\u043d\u0438\u0446\u044b \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u043e\u0432",
      "items": {
        "type": "object",
        "properties": {
          "parameter_name": {
            "type": "string"
          },
          "green_min": {
            "type": "number"
          },
          "green_max": {
            "type": "number"
          },
          "yellow_min": {
            "type": "number"
          },
          "yellow_max": {
            "type": "number"
          },
          "red_min": {
            "type": "number"
          },
          "red_max": {
            "type": "number"
          }
        }
      }
    },
    "comments": {
      "type": "string",
      "title": "Comments"
    }
  },
  "required": [
    "client_id",
    "asset_id",
    "unit_name",
    "equipment_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "superintendent"
              }
            },
            {
              "data.client_id": "{{user.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "captain"
              }
            },
            {
              "data.asset_id": "{{user.asset_id}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "superintendent"
              }
            },
            {
              "data.client_id": "{{user.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "captain"
              }
            },
            {
              "data.asset_id": "{{user.asset_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "superintendent"
              }
            },
            {
              "data.client_id": "{{user.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "captain"
              }
            },
            {
              "data.asset_id": "{{user.asset_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "superintendent"
              }
            },
            {
              "data.client_id": "{{user.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "captain"
              }
            },
            {
              "data.asset_id": "{{user.asset_id}}"
            }
          ]
        }
      ]
    }
  }
}
