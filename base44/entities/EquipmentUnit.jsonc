{
  "name": "EquipmentUnit",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "title": "Client"
    },
    "asset_id": {
      "type": "string",
      "title": "Asset"
    },
    "unit_name": {
      "type": "string",
      "title": "Unit Name"
    },
    "equipment_type": {
      "type": "string",
      "title": "Equipment Type",
      "enum": [
        "main_engine",
        "aux_engine",
        "generator",
        "gearbox",
        "hydraulic",
        "compressor",
        "pump",
        "other"
      ]
    },
    "manufacturer": {
      "type": "string",
      "title": "Manufacturer"
    },
    "model": {
      "type": "string",
      "title": "Model"
    },
    "serial_number": {
      "type": "string",
      "title": "Serial Number"
    },
    "total_operating_hours": {
      "type": "number",
      "title": "Total Operating Hours"
    },
    "oil_type_id": {
      "type": "string",
      "title": "Oil Type (ref)"
    },
    "oil_brand": {
      "type": "string",
      "title": "Oil Brand / Name"
    },
    "oil_volume": {
      "type": "number",
      "title": "Oil Volume (L)"
    },
    "oil_change_type": {
      "type": "string",
      "title": "Oil Change Method",
      "enum": [
        "engine_hours",
        "mileage",
        "calendar",
        "condition"
      ]
    },
    "oil_filter_type": {
      "type": "string",
      "title": "Oil Filter Type"
    },
    "oil_filter_brand": {
      "type": "string",
      "title": "Oil Filter Brand"
    },
    "oil_filter_article": {
      "type": "string",
      "title": "Oil Filter Article"
    },
    "comments": {
      "type": "string",
      "title": "Comments"
    }
  },
  "required": [
    "client_id",
    "asset_id",
    "unit_name",
    "equipment_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "superintendent"
              }
            },
            {
              "data.client_id": "{{user.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "captain"
              }
            },
            {
              "data.asset_id": "{{user.asset_id}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "superintendent"
              }
            },
            {
              "data.client_id": "{{user.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "captain"
              }
            },
            {
              "data.asset_id": "{{user.asset_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "superintendent"
              }
            },
            {
              "data.client_id": "{{user.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "captain"
              }
            },
            {
              "data.asset_id": "{{user.asset_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "superintendent"
              }
            },
            {
              "data.client_id": "{{user.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "captain"
              }
            },
            {
              "data.asset_id": "{{user.asset_id}}"
            }
          ]
        }
      ]
    }
  }
}