      "type": "string",
      "title": "Manufacturer"
    },
    "oil_category": {
      "type": "string",
      "title": "Oil Category"
    },
    "iso_vg_grade": {
      "type": "string",
      "title": "ISO VG Grade"
    },
    "sae_grade": {
      "type": "string",
      "title": "SAE Grade"
    },
    "passport_viscosity_40": {
      "type": "number",
      "title": "Viscosity at 40C (mm2/s)"
    },
    "passport_viscosity_100": {
      "type": "number",
      "title": "Viscosity at 100C (mm2/s)"
    },
    "passport_viscosity_index": {
      "type": "number",
      "title": "Viscosity Index"
    },
    "passport_density_15": {
      "type": "number",
      "title": "Density at 15C (kg/m3)"
    },
    "passport_flash_point": {
      "type": "number",
      "title": "Flash Point (C)"
    },
    "passport_pour_point": {
      "type": "number",
      "title": "Pour Point (C)"
    },
    "passport_dielectric": {
      "type": "number",
      "title": "Dielectric Constant"
    },
    "passport_tbn": {
      "type": "number",
      "title": "TBN (mg KOH/g)"
    },
    "passport_tan": {
      "type": "number",
      "title": "TAN (mg KOH/g)"
    },
    "passport_ash_content": {
      "type": "number",
      "title": "Ash Content (%)"
    },
    "lab_viscosity_40": {
      "type": "number",
      "title": "Lab Viscosity at 40C"
    },
    "lab_viscosity_100": {
      "type": "number",
      "title": "Lab Viscosity at 100C"
    },
    "lab_density": {
      "type": "number",
      "title": "Lab Density (kg/m3)"
    },
    "lab_dielectric": {
      "type": "number",
      "title": "Lab Dielectric Constant"
    },
    "lab_water_activity": {
      "type": "number",
      "title": "Lab Water Activity (aw)"
    },
    "lab_water_ppm": {
      "type": "number",
      "title": "Lab Dissolved Water (ppm)"
    },
    "lab_measured_date": {
      "type": "string",
      "title": "Lab Measurement Date",
      "format": "date"
    },
    "lab_comments": {
      "type": "string",
      "title": "Lab Comments"
    },
    "comments": {
      "type": "string",
      "title": "Comments"
    }
