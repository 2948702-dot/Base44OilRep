{
  "name": "OilReference",
  "type": "object",
  "properties": {
    "oil_name": {
      "type": "string",
      "title": "Oil Name"
    },
    "manufacturer": {
      "type": "string",
      "title": "Manufacturer"
    },
    "oil_category": {
      "type": "string",
      "title": "Oil Category"
    },
    "iso_vg_grade": {
      "type": "string",
      "title": "ISO VG Grade",
      "enum": [
        "ISO VG 15",
        "ISO VG 22",
        "ISO VG 32",
        "ISO VG 46",
        "ISO VG 68",
        "ISO VG 100",
        "ISO VG 150",
        "ISO VG 220",
        "ISO VG 320",
        "ISO VG 460",
        "ISO VG 680",
        "ISO VG 1000"
      ]
    },
    "sae_grade": {
      "type": "string",
      "title": "SAE Grade",
      "enum": [
        "SAE 10W",
        "SAE 15W",
        "SAE 20W",
        "SAE 20",
        "SAE 30",
        "SAE 40",
        "SAE 50",
        "SAE 60",
        "SAE 75W",
        "SAE 85W",
        "SAE 80W-90",
        "SAE 85W-140"
      ]
    },
    "passport_viscosity_40": {
      "type": "number",
      "title": "Viscosity at 40C (mm2/s)"
    },
    "passport_viscosity_100": {
      "type": "number",
      "title": "Viscosity at 100C (mm2/s)"
    },
    "passport_viscosity_index": {
      "type": "number",
      "title": "Viscosity Index"
    },
    "passport_density_15": {
      "type": "number",
      "title": "Density at 15C (kg/m3)"
    },
    "passport_flash_point": {
      "type": "number",
      "title": "Flash Point (C)"
    },
    "passport_pour_point": {
      "type": "number",
      "title": "Pour Point (C)"
    },
    "passport_dielectric": {
      "type": "number",
      "title": "Dielectric Constant"
    },
    "passport_tbn": {
      "type": "number",
      "title": "TBN (mg KOH/g)"
    },
    "passport_tan": {
      "type": "number",
      "title": "TAN (mg KOH/g)"
    },
    "passport_ash_content": {
      "type": "number",
      "title": "Ash Content (%)"
    },
    "comments": {
      "type": "string",
      "title": "Comments"
    }
  },
  "required": [
    "oil_name",
    "manufacturer"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "superintendent"
          }
        }
      ]
    },
    "read": {},
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "superintendent"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "superintendent"
          }
        }
      ]
    }
  }
}