{
  "name": "OilLifecycle",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "title": "Client"
    },
    "asset_id": {
      "type": "string",
      "title": "Asset"
    },
    "equipment_unit_id": {
      "type": "string",
      "title": "Equipment Unit"
    },
    "oil_type_id": {
      "type": "string",
      "title": "Oil Type"
    },
    "start_date": {
      "type": "string",
      "title": "Start Date",
      "format": "date"
    },
    "start_operating_hours": {
      "type": "number",
      "title": "Start Operating Hours"
    },
    "end_date": {
      "type": "string",
      "title": "End Date",
      "format": "date"
    },
    "end_operating_hours": {
      "type": "number",
      "title": "End Operating Hours"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "active",
        "closed"
      ]
    },
    "start_reason": {
      "type": "string",
      "title": "Start Reason"
    },
    "end_reason": {
      "type": "string",
      "title": "End Reason"
    },
    "comments": {
      "type": "string",
      "title": "Comments"
    }
  },
  "required": [
    "client_id",
    "asset_id",
    "equipment_unit_id",
    "oil_type_id",
    "start_date",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "superintendent"
              }
            },
            {
              "data.client_id": "{{user.client_id}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "superintendent"
              }
            },
            {
              "data.client_id": "{{user.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "captain"
              }
            },
            {
              "data.asset_id": "{{user.asset_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "superintendent"
              }
            },
            {
              "data.client_id": "{{user.client_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "superintendent"
              }
            },
            {
              "data.client_id": "{{user.client_id}}"
            }
          ]
        }
      ]
    }
  }
}
