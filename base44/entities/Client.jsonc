{
  "name": "Client",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string",
      "title": "Company Name"
    },
    "contact_person": {
      "type": "string",
      "title": "Contact Person"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "address": {
      "type": "string",
      "title": "Address"
    },
    "comments": {
      "type": "string",
      "title": "Comments"
    }
  },
  "required": [
    "company_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "client_admin"
              }
            },
            {
              "id": "{{user.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "lab_technician"
              }
            },
            {
              "id": "{{user.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "superintendent"
              }
            },
            {
              "id": "{{user.client_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
