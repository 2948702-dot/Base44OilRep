{
  "name": "OilSample",
  "type": "object",
  "properties": {
    "sample_type": {
      "type": "string",
      "title": "Sample Type",
      "enum": [
        "fresh_oil",
        "in_service"
      ]
    },
    "sample_number": {
      "type": "string",
      "title": "Sample Number"
    },
    "sample_origin": {
      "type": "string",
      "title": "Sample Origin",
      "enum": [
        "own_sampling",
        "client_delivered",
        "historical_import"
      ]
    },
    "container_type": {
      "type": "string",
      "title": "Container Type",
      "enum": [
        "smartoil_can",
        "client_container",
        "unknown"
      ]
    },
    "external_sample_label": {
      "type": "string",
      "title": "External Sample Label"
    },
    "can_qr_code": {
      "type": "string",
      "title": "Can QR Code"
    },
    "client_id": {
      "type": "string",
      "title": "Client"
    },
    "asset_id": {
      "type": "string",
      "title": "Asset"
    },
    "equipment_unit_id": {
      "type": "string",
      "title": "Equipment Unit"
    },
    "oil_type_id": {
      "type": "string",
      "title": "Oil Type"
    },
    "lifecycle_id": {
      "type": "string",
      "title": "Oil Lifecycle"
    },
    "applies_to_equipment_unit_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Applies To Equipment Units"
    },
    "applies_to_lifecycle_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Applies To Oil Lifecycles"
    },
    "sampling_date": {
      "type": "string",
      "title": "Sampling Date",
      "format": "date"
    },
    "received_date": {
      "type": "string",
      "title": "Received Date",
      "format": "date"
    },
    "received_by": {
      "type": "string",
      "title": "Received By"
    },
    "hours_source": {
      "type": "string",
      "title": "Hours Source",
      "enum": [
        "reported_by_client",
        "current_unit_state",
        "unknown"
      ]
    },
    "total_hours_at_sampling": {
      "type": "number",
      "title": "Total Hours at Sampling"
    },
    "oil_hours_at_sampling": {
      "type": "number",
      "title": "Oil Hours at Sampling"
    },
    "engine_state": {
      "type": "string",
      "title": "Engine State",
      "enum": [
        "warm",
        "cold"
      ]
    },
    "sample_status": {
      "type": "string",
      "title": "Sample Status",
      "enum": [
        "pending",
        "in_analysis",
        "completed",
        "cancelled"
      ]
    },
    "batch_number": {
      "type": "string",
      "title": "Batch Number"
    },
    "production_date": {
      "type": "string",
      "title": "Production Date",
      "format": "date"
    },
    "storage_type": {
      "type": "string",
      "title": "Storage Type"
    },
    "delivery_date": {
      "type": "string",
      "title": "Delivery Date",
      "format": "date"
    },
    "supplier": {
      "type": "string",
      "title": "Supplier"
    },
    "operator_user_id": {
      "type": "string",
      "title": "Operator"
    },
    "comments": {
      "type": "string",
      "title": "Comments"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Attachments"
    }
  },
  "required": [
    "sample_number",
    "client_id",
    "sample_type",
    "sampling_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "client_admin"
              }
            },
            {
              "data.client_id": "{{user.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "lab_technician"
              }
            },
            {
              "data.client_id": "{{user.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "superintendent"
              }
            },
            {
              "data.client_id": "{{user.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "captain"
              }
            },
            {
              "data.asset_id": "{{user.asset_id}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "client_admin"
              }
            },
            {
              "data.client_id": "{{user.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "lab_technician"
              }
            },
            {
              "data.client_id": "{{user.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "superintendent"
              }
            },
            {
              "data.client_id": "{{user.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "captain"
              }
            },
            {
              "data.asset_id": "{{user.asset_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "client_admin"
              }
            },
            {
              "data.client_id": "{{user.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "lab_technician"
              }
            },
            {
              "data.client_id": "{{user.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "superintendent"
              }
            },
            {
              "data.client_id": "{{user.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "captain"
              }
            },
            {
              "data.asset_id": "{{user.asset_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "client_admin"
              }
            },
            {
              "data.client_id": "{{user.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "superintendent"
              }
            },
            {
              "data.client_id": "{{user.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "captain"
              }
            },
            {
              "data.asset_id": "{{user.asset_id}}"
            }
          ]
        }
      ]
    }
  }
}
