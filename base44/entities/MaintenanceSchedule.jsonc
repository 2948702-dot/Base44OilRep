{
  "name": "MaintenanceSchedule",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "title": "Client"
    },
    "asset_id": {
      "type": "string",
      "title": "Asset"
    },
    "equipment_unit_id": {
      "type": "string",
      "title": "Equipment Unit"
    },
    "maintenance_type": {
      "type": "string",
      "title": "Maintenance Type"
    },
    "event_type": {
      "type": "string",
      "title": "Linked Event Type",
      "enum": [
        "oil_change",
        "oil_topup",
        "hour_reading",
        "oil_filter",
        "air_filter",
        "repair",
        "component_replacement",
        "other"
      ]
    },
    "planning_method": {
      "type": "string",
      "title": "Planning Method",
      "enum": [
        "hours",
        "date",
        "whichever_first"
      ]
    },
    "interval_hours": {
      "type": "number",
      "title": "Interval (hours)"
    },
    "interval_days": {
      "type": "number",
      "title": "Interval (days)"
    },
    "target_hours": {
      "type": "number",
      "title": "Target Total Hours"
    },
    "target_date": {
      "type": "string",
      "title": "Target Date",
      "format": "date"
    },
    "initial_target_hours": {
      "type": "number",
      "title": "Initial Target Hours"
    },
    "initial_target_date": {
      "type": "string",
      "title": "Initial Target Date",
      "format": "date"
    },
    "current_hours": {
      "type": "number",
      "title": "Current Hours"
    },
    "remaining_hours": {
      "type": "number",
      "title": "Remaining Hours"
    },
    "remaining_days": {
      "type": "number",
      "title": "Remaining Days"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "normal",
        "due_soon",
        "overdue"
      ]
    },
    "notification_enabled": {
      "type": "boolean",
      "title": "Enable Notifications"
    },
    "completed_count": {
      "type": "number",
      "title": "Completed Events Count"
    },
    "last_completed_event_id": {
      "type": "string",
      "title": "Last Completed Event"
    },
    "last_completed_date": {
      "type": "string",
      "title": "Last Completed Date",
      "format": "date"
    },
    "last_completed_hours": {
      "type": "number",
      "title": "Last Completed Hours"
    },
    "last_planned_date": {
      "type": "string",
      "title": "Last Planned Date",
      "format": "date"
    },
    "last_planned_hours": {
      "type": "number",
      "title": "Last Planned Hours"
    },
    "last_date_variance_days": {
      "type": "number",
      "title": "Last Date Variance (days)"
    },
    "last_hours_variance": {
      "type": "number",
      "title": "Last Hours Variance"
    },
    "last_completion_status": {
      "type": "string",
      "title": "Last Completion Status",
      "enum": [
        "early",
        "on_time",
        "late"
      ]
    },
    "comments": {
      "type": "string",
      "title": "Comments"
    }
  },
  "required": [
    "client_id",
    "asset_id",
    "maintenance_type",
    "planning_method"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "superintendent"
              }
            },
            {
              "data.client_id": "{{user.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "captain"
              }
            },
            {
              "data.asset_id": "{{user.asset_id}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "superintendent"
              }
            },
            {
              "data.client_id": "{{user.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "captain"
              }
            },
            {
              "data.asset_id": "{{user.asset_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "superintendent"
              }
            },
            {
              "data.client_id": "{{user.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "captain"
              }
            },
            {
              "data.asset_id": "{{user.asset_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "superintendent"
              }
            },
            {
              "data.client_id": "{{user.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "captain"
              }
            },
            {
              "data.asset_id": "{{user.asset_id}}"
            }
          ]
        }
      ]
    }
  }
}
